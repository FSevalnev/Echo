# Google Gemini — free tier, no billing/card required.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase — powers accounts (sign in) and saved progress history.
# Create a free project at https://supabase.com/dashboard, then find these
# under Project Settings -> API. See supabase/schema.sql for the DB setup
# and supabase/SETUP.md for full step-by-step instructions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
